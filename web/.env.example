# Copy to .env.local and fill in.
VITE_NETWORK_ID=testnet
# The deployed Proctor contract.
VITE_CONTRACT_ID=
VITE_RPC_URL=https://rpc.testnet.near.org
# Used when VITE_RPC_URL is busy or unreachable (comma-separated; empty for none).
VITE_RPC_FALLBACK_URLS=https://rpc.testnet.fastnear.com
# Archival RPC for verification (keeps old transactions); falls back to VITE_RPC_URL.
VITE_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.near.org
VITE_EXPLORER_URL=https://testnet.nearblocks.io
VITE_SOURCE_URL=https://github.com/Modemola/near
# Set shown on the home page.
VITE_FEATURED_SET=
